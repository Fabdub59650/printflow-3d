#!/bin/bash
# .xinitrc — PrintFlow-3D Kiosque v2.9.4
# Copier vers ~/.xinitrc sur le Raspberry Pi
# cp /opt/printflow/scripts/xinitrc.example ~/.xinitrc

# Désactiver économiseur d'écran et DPMS
xset s off
xset s noblank
xset -dpms

# Masquer le curseur X
xsetroot -cursor_name left_ptr 2>/dev/null || true

# Masquer le curseur après inactivité
unclutter -idle 0 -root &

# Lancer le gestionnaire de fenêtres
openbox &
sleep 8  # Laisser le temps au réseau et à Nginx de s'initialiser

# Attendre que Nginx soit prêt
until curl -sk https://localhost > /dev/null 2>&1; do
  sleep 1
done

# Attendre que PrintFlow soit prêt (max 60s)
TRIES=0
until curl -sk https://localhost/api/settings > /dev/null 2>&1 || [ $TRIES -ge 30 ]; do
  sleep 2
  TRIES=$((TRIES+1))
done

# Lancer Chromium en mode kiosque avec redémarrage automatique
while true; do
  chromium \
    --kiosk \
    --noerrdialogs \
    --disable-infobars \
    --disable-session-crashed-bubble \
    --disable-restore-session-state \
    --touch-events=enabled \
    --enable-touch-drag-drop \
    --use-gl=egl \
    --cursor-invisible \
    --disk-cache-size=0 \
    --disable-background-timer-throttling \
    --disable-backgrounding-occluded-windows \
    --disable-renderer-backgrounding \
    --disable-background-networking \
    --disable-hang-monitor \
    --window-size=1024,600 \
    --window-position=0,0 \
    --disable-pinch \
    --overscroll-history-navigation=0 \
    http://localhost/kiosk
  sleep 5
done
